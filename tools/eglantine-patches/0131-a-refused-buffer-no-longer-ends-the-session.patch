+        }
+    } catch (const std::bad_alloc&) {
+        // The usage tracker of a large buffer: the same answer.
+    }
+    return std::nullopt;
+}
+
+std::optional<Buffer> BufferCacheRuntime::TryCreateBufferInHoles(DAddr cpu_addr, u64 size) {
+    vk::Buffer made = CreateBuffer(device, memory_allocator, size, 0, true);
+    if (!made) {
+        return std::nullopt;
+    }
+    try {
+        return std::optional<Buffer>{std::in_place, *this, cpu_addr, size, std::move(made)};
+    } catch (const std::bad_alloc&) {
+        return std::nullopt;
+    }
+}
