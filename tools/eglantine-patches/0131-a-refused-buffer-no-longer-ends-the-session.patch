+    // A leap adds 8 MiB for a buffer that keeps growing. With nothing to spare it can do without.
+    if (const BufferId id = JoinBuffer(device_addr, wanted_size, sparse_compatible, false)) {
+        buffer_refused_size = ~u64{0};
