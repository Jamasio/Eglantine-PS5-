+std::optional<Buffer> BufferCacheRuntime::TryCreateBuffer(DAddr cpu_addr, u64 size,
+                                                          bool sparse_compatible) {
+    try {
+        return std::optional<Buffer>{std::in_place, *this, cpu_addr, size, sparse_compatible};
