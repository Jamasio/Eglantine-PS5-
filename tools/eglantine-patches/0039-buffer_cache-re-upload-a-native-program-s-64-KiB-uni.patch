From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kraibse <33869366+kraibse@users.noreply.github.com>
Date: Thu, 5 Nov 2026 04:26:51 +0100
Subject: [PATCH] buffer_cache: re-upload a native program's 64 KiB uniform
 bank once per frame

Native programs keep tables next to their code in a 64 KiB bank read
with indirect offsets. Writes to that memory can go unnoticed by the
memory tracker, leaving stale host contents.

Ported from Quixomatic/Eglantine dev 911309003d (Franseven, itself from
monkeefunnee/Eglantine raiders-fix cbf7307b31), with the page constants
qualified as in e732fd1290.

Co-authored-by: Franseven <spett2013@yahoo.it>
Assisted-by: Claude Opus 5.5 (ported the fix)
(cherry picked from commit 5c7da2713a85c4bdc78da004aa6a13577c87f14a)
---
 src/video_core/buffer_cache/buffer_cache.h     | 18 ++++++++++++++++++
 .../buffer_cache/buffer_cache_base.h           |  3 +++
 2 files changed, 21 insertions(+)

diff --git a/src/video_core/buffer_cache/buffer_cache.h b/src/video_core/buffer_cache/buffer_cache.h
index 40158ef2a5..0124ee0c08 100644
--- a/src/video_core/buffer_cache/buffer_cache.h
+++ b/src/video_core/buffer_cache/buffer_cache.h
@@ -106,6 +106,7 @@ void BufferCache<P>::TickFrame() {
         return;
     }
     runtime.TickFrame(slot_buffers);
+    native_indirect_uniforms_this_frame.clear();
     if (frame_tick % 600 == 0 && !uploaded_buffer_ranges.empty()) {
         for (const auto& [address, size] : uploaded_buffer_ranges) {
             device_memory.HintCold(address, size);
@@ -1156,6 +1157,23 @@ void BufferCache<P>::BindHostGraphicsUniformBuffer(size_t stage, u32 index, u32
             return alignment > 1 && (offset % alignment) != 0;
         }
     }();
+    // Native programs keep tables next to their code in a 64 KiB bank read with indirect offsets
+    // (Splatoon Raiders: the dialogue box corners in c1). Writes to that memory can go unnoticed by
+    // the memory tracker, leaving stale host contents, so upload such a bank again once per frame.
+    if (has_host_buffer && (*channel_state->uniform_buffer_sizes)[stage][index] == 0x10000 &&
+        size != 0 && gpu_memory != nullptr && gpu_memory->UsesNativeTiling() &&
+        !memory_tracker.IsRegionGpuModified(device_addr, size) &&
+        native_indirect_uniforms_this_frame.insert(device_addr).second) {
+        // The bank size is only an upper limit: stop at the end of the mapped memory.
+        u64 mapped_size = 0;
+        while (mapped_size < size &&
+               device_memory.template GetPointer<u8>(device_addr + mapped_size) != nullptr) {
+            mapped_size += Core::DEVICE_PAGESIZE - ((device_addr + mapped_size) & Core::DEVICE_PAGEMASK);
+        }
+        if (mapped_size != 0) {
+            memory_tracker.MarkRegionAsCpuModified(device_addr, (std::min<u64>)(mapped_size, size));
+        }
+    }
     const bool use_fast_buffer = needs_alignment_stream
         || (has_host_buffer && size <= channel_state->uniform_buffer_skip_cache_size
             && !memory_tracker.IsRegionGpuModified(device_addr, size));
diff --git a/src/video_core/buffer_cache/buffer_cache_base.h b/src/video_core/buffer_cache/buffer_cache_base.h
index c3156ce901..dfa7deec8d 100644
--- a/src/video_core/buffer_cache/buffer_cache_base.h
+++ b/src/video_core/buffer_cache/buffer_cache_base.h
@@ -17,6 +17,7 @@
 #include <optional>
 #include <span>
 #include <unordered_map>
+#include <unordered_set>
 #include <vector>
 
 #include "common/container/unordered_map.h"
@@ -377,6 +378,8 @@ public:
     Common::SpinRecursiveMutex mutex;
     Runtime& runtime;
     bool any_buffer_uploaded = false;
+    /// Indirectly read banks of native programs already uploaded this frame.
+    std::unordered_set<DAddr> native_indirect_uniforms_this_frame;
 
     /// EDEN_NX2_DRAW_TUNING=0 turns off the two per-draw shortcuts below.
     static bool Nx2DrawTuning() {
