From 550be4239398256a5bbdec5489f16488a7f9dfe2 Mon Sep 17 00:00:00 2001
From: exploitizm <351399878+exploitizm@users.noreply.github.com>
Date: Tue, 3 Nov 2026 13:58:43 +1000
Subject: [PATCH] Quarter the descriptor update queues

At 24 bytes an entry and 8 frames in flight, upstream's sizes held 120 MiB of
the PS5's shared 12 GiB (96 + 24 MiB). A frame that needs more waits for the
worker and starts its payload again. No overflow warnings were seen at a
quarter of the size, with Donkey Kong Bananza drawing ~4,400 times a frame.

Was tools/eglantine-patches/0032-descriptor-queues-quarter-size.patch in the port's previous source tree.
---
 src/video_core/renderer_vulkan/vk_update_descriptor.h | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/src/video_core/renderer_vulkan/vk_update_descriptor.h b/src/video_core/renderer_vulkan/vk_update_descriptor.h
index 9f30e65dbd..307a636209 100644
--- a/src/video_core/renderer_vulkan/vk_update_descriptor.h
+++ b/src/video_core/renderer_vulkan/vk_update_descriptor.h
@@ -40,8 +40,11 @@ class UpdateDescriptorQueue final {
     static constexpr size_t FRAMES_IN_FLIGHT = 8;
 
 public:
-    static constexpr size_t GUEST_FRAME_PAYLOAD_SIZE = 0x80000;
-    static constexpr size_t COMPUTE_FRAME_PAYLOAD_SIZE = 0x20000;
+    // A quarter of upstream's sizes: at 24 bytes an entry and 8 frames they held 120 MiB of the
+    // PS5's shared 12 GiB (96 + 24 MiB), and a frame that needs more waits for the worker and
+    // starts its payload again (Acquire). Title 4 (Donkey Kong Bananza) draws ~4,400 times a frame.
+    static constexpr size_t GUEST_FRAME_PAYLOAD_SIZE = 0x20000;
+    static constexpr size_t COMPUTE_FRAME_PAYLOAD_SIZE = 0x8000;
 
     explicit UpdateDescriptorQueue(const Device& device_, size_t frame_payload_size_,
                                    bool supports_descriptor_buffer_ = false);
