+namespace {
+
+// A release queued for the split's back. A release of a known word is overlaid by readers; a
+// timed one writes 16 bytes the front does not know, so they wait for it.
+void NoteSemaphoreWrite(DmaPusher& dma_pusher, GPUVAddr address, const u32* payload) {
+    auto& split = VideoCommon::GpuSplit::Get();
+    if (!split.NotesWrites()) {
+        return;
+    }
+    const auto device = dma_pusher.memory_manager.GpuToCpuAddress(address);
+    if (!device) {
+        return; // Queries write nothing at an unmapped address.
+    }
+    if (payload != nullptr) {
+        split.NoteMemoryWriteData(*device, payload, 1);
+    } else {
+        split.NoteMemoryWrite(*device, 16);
+    }
+}
