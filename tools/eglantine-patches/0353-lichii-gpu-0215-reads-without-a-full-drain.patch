+void Maxwell3D::FrontNoteMemoryWrite(VideoCommon::GpuSplit& split, FrontState& fs, u32 method,
+                                     const u32* words, u32 count) {
+    const auto unknown = [&split] { split.NoteMemoryWrite(0, ~u64{0}); };
+    if (method == MAXWELL3D_REG_INDEX(report_semaphore.query)) {
+        constexpr u32 base = MAXWELL3D_REG_INDEX(report_semaphore);
+        const GPUVAddr address = (GPUVAddr{fs.regs[base]} << 32) | fs.regs[base + 1];
+        Regs::ReportSemaphore query_regs{};
+        query_regs.query.raw = words[count - 1];
+        const auto device = memory_manager.GpuToCpuAddress(address);
+        if (!device) {
+            return; // CounterReport writes nothing at an unmapped address.
+        }
+        // Payload reports are written when the back runs them (CounterReport, fast fences), a
+        // short release as a fence with the known word. Counters land when the host query ends.
+        if (query_regs.query.report != Regs::ReportSemaphore::Report::Payload) {
+            split.NoteLateWrite(*device);
+        } else if (query_regs.query.operation == Regs::ReportSemaphore::Operation::Release &&
+                   query_regs.query.short_query != 0) {
+            const u32 payload = fs.regs[base + 2];
+            split.NoteMemoryWriteData(*device, &payload, 1);
+        } else {
+            split.NoteMemoryWrite(*device, 16);
+        }
+        return;
+    }
+    constexpr u32 base = MAXWELL3D_REG_INDEX(upload);
+    if (method == MAXWELL3D_REG_INDEX(launch_dma)) {
+        const u64 line_length = fs.regs[base];
+        const u64 lines = (std::max)(fs.regs[base + 1], 1U);
+        const u64 pitch = (std::max<u64>)(fs.regs[base + 4], line_length);
+        const GPUVAddr address = (GPUVAddr{fs.regs[base + 2]} << 32) | fs.regs[base + 3];
+        const u64 size = pitch * (lines - 1) + line_length;
+        const auto device = memory_manager.GpuToCpuAddress(address);
+        // LAUNCH_DMA: bit 0 pitch (linear) layout, bits 5:4 completion (2 releases a semaphore).
+        const u32 launch = words[count - 1];
+        const bool linear = (launch & 1) != 0;
+        if (((launch >> 4) & 3) == 2) {
+            unknown();
+        }
+        fs.upload_known = device && linear && lines == 1 && (*device & 3) == 0 &&
+                          memory_manager.GpuToCpuAddress(address + size - 1) == *device + size - 1;
+        fs.upload_device = device.value_or(0);
+        fs.upload_size = static_cast<u32>((std::min<u64>)(size, ~0U));
+        fs.upload_offset = 0;
+        if (!fs.upload_known) {
+            // Block-linear uploads swizzle into more than their lines (engine_upload.cpp).
+            if (!device || !linear || size == 0 || size > (u64{64} << 20)) {
+                return unknown();
+            }
+            split.NoteMemoryWrite(*device, size);
+        }
+        return;
+    }
+    // inline_data words of the current upload.
+    if (!fs.upload_known) {
+        const auto device = memory_manager.GpuToCpuAddress(
+            (GPUVAddr{fs.regs[base + 2]} << 32) | fs.regs[base + 3]);
+        if (!device || (fs.regs[MAXWELL3D_REG_INDEX(launch_dma)] & 1) == 0) {
+            return unknown();
+        }
+        split.NoteMemoryWrite(*device, fs.regs[base] * u64{(std::max)(fs.regs[base + 1], 1U)} +
+                                           u64{fs.regs[base + 4]} * fs.regs[base + 1]);
+        return;
+    }
+    const u32 remaining_bytes =
+        fs.upload_offset < fs.upload_size ? fs.upload_size - fs.upload_offset : 0;
+    const u32 whole = (std::min<u32>)(count, remaining_bytes / 4);
+    split.NoteMemoryWriteData(fs.upload_device + fs.upload_offset, words, whole);
+    if (whole < count && remaining_bytes % 4 != 0) {
+        split.NoteMemoryWrite(fs.upload_device + fs.upload_offset + whole * 4, remaining_bytes % 4);
+    }
+    fs.upload_offset += (std::min<u32>)(count * 4, remaining_bytes);
+}
+
+// EDEN_NX2_DMA_WAIT_WRITERS (gpu_split.h): the read of a macro without a full drain, or false.
+// From Lichii PR 179 (zortos293/Lichii, head 3ce0ab7106). Changed from the PR: only modes 3 to 6; the
+// queued compute, copy, inline-to-memory and 2D work runs first, as PR 161's version does, so the
+// written-page bits are current (the PR reads past them and only looks at inline uploads, reports
+// and semaphores); reads that cross a mapping break drain; the words come from Read<u32>, which
+// knows the syncpoint shim. What is left unseen: a draw's first shader store to a page.
+bool Maxwell3D::FrontDmaReadFast(VideoCommon::GpuSplit& split, FrontState& fs, GPUVAddr source,
+                                 u32 words, u32 method, u32 ram) {
+    const int mode = VideoCommon::DmaWaitWritersMode();
+    const size_t read_bytes = size_t{words} * sizeof(u32);
+    if (mode < 3 || words == 0 || !split.NotesWrites()) {
+        return false;
+    }
+    split.WaitForEngineWriters(VideoCommon::DrainSite::MacroDmaRead);
+    const auto device = memory_manager.GpuToCpuAddress(source);
+    if (!device || memory_manager.MaxContinuousRange(source, read_bytes) < read_bytes ||
+        split.HasLateWrites(*device, read_bytes)) {
+        return false;
+    }
+    for (GPUVAddr page = *device & ~u64{0xfff}; page < *device + read_bytes; page += 0x1000) {
+        if (Tegra::Nx2IsGpuWritten(page)) {
+            return false;
+        }
+    }
+    const auto read_words = [&] {
+        fs.dma_words.resize(words);
+        for (u32 i = 0; i < words; ++i) {
+            fs.dma_words[i] = memory_manager.Read<u32>(source + u64{i} * sizeof(u32));
+        }
+    };
+    bool known = false;
+    if (mode >= 5) {
+        const u64 since = split.ConsumedNow();
+        read_words();
+        known = split.OverlayQueuedWrites(since, *device, fs.dma_words.data(), words);
+    }
+    if (!known) {
+        if (!split.WaitForWritesTo(*device, read_bytes, VideoCommon::DrainSite::MacroDmaRead)) {
+            return false;
+        }
+        read_words();
+    }
+    if (mode == 4 || mode == 6) {
+        static u64 checks{};
+        static u64 differences{};
+        const std::vector<u32> fast = fs.dma_words;
+        split.Defer([memory = &memory_manager, source, read_bytes] {
+            if (memory->IsMemoryDirty(source, read_bytes, VideoCommon::CacheType::BufferCache)) {
+                memory->FlushRegion(source, read_bytes, VideoCommon::CacheType::BufferCache);
+            }
+        });
+        split.Drain(VideoCommon::DrainSite::MacroDmaRead);
+        read_words();
+        ++checks;
+        if (fast != fs.dma_words && differences++ < 16) {
+            LOG_WARNING(HW_GPU, "DMA read check: {} words at {:#x} differ from the drained read",
+                        words, source);
+        }
+        if ((checks & 0xffff) == 0) {
+            LOG_INFO(HW_GPU, "DMA read check: {} reads, {} differed", checks, differences);
+        }
+    }
+    for (u32 i = 0; i < words; ++i) {
+        if (method == 0x158) {
+            fs.parameters.push_back(fs.dma_words[i]);
+        } else if (ram + i < native_data_ram.size()) {
+            native_data_ram[ram + i] = fs.dma_words[i];
+        }
+    }
+    return true;
+}
