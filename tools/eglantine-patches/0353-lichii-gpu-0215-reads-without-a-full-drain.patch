+// EDEN_NX2_SEM_FAST (gpu_split.h): whether the acquire about to run is met without a full drain.
+// From Lichii PR 179 (zortos293/Lichii, head 3ce0ab7106, there "not verified yet"); the first wait is
+// from PR 161 (64bb6fe0d7). Changed from PR 179: the queued compute, copy, inline-to-memory and 2D
+// work runs first, so the written-page bits and those engines' own releases are current (PR 179
+// reads past them); =3 checks against the drained read and changes nothing. Only a met acquire
+// skips the drain: a word that does not match goes the usual way, so this cannot turn a wait into
+// a pass unless a write it does not know of would have changed a word that already matches.
+bool Puller::AcquireMetWithoutDrain(DmaPusher& dma_pusher) {
+    const int mode = VideoCommon::SemFastMode();
+    auto& split = VideoCommon::GpuSplit::Get();
+    if (mode == 0 || !g_nx2_ampere || !split.Active() || !split.NotesWrites()) {
+        return false;
+    }
+    const auto op = GpuSemaphoreOperation(regs.semaphore_trigger & 0xF);
+    if (op != GpuSemaphoreOperation::AcquireEqual && op != GpuSemaphoreOperation::AcquireGequal &&
+        op != GpuSemaphoreOperation::AcquireMask) {
+        return false;
+    }
+    const GPUVAddr address = regs.semaphore_address.SemaphoreAddress();
+    const auto device = dma_pusher.memory_manager.GpuToCpuAddress(address);
+    if (!device) {
+        return false;
+    }
+    split.WaitForEngineWriters(VideoCommon::DrainSite::Acquire);
+    if (Nx2IsGpuWritten(*device) || split.HasLateWrites(*device, 4)) {
+        return false;
+    }
+    u32 word{};
+    bool known = false;
+    if (mode >= 2) {
+        const u64 since = split.ConsumedNow();
+        word = dma_pusher.memory_manager.Read<u32>(address);
+        known = split.OverlayQueuedWrites(since, *device, &word, 1);
+    }
+    if (!known) {
+        if (!split.WaitForWritesTo(*device, 16, VideoCommon::DrainSite::Acquire)) {
+            return false;
+        }
+        word = dma_pusher.memory_manager.Read<u32>(address);
+    }
+    const PendingAcquire acquire{
+        .address = address,
+        .value = regs.semaphore_sequence,
+        .operation = static_cast<u32>(op),
+        .since = {},
+        .reported = false,
+    };
+    const bool met = acquire.Matches(word);
+    if (mode == 3) {
+        static u64 checks{};
+        static u64 differences{};
+        static u64 met_later{};
+        const u32 exact = ReadSemaphoreWord(dma_pusher, address);
+        ++checks;
+        // A fast "not met" does no harm: it goes the usual way, and a CPU release during the
+        // drain makes those by itself. Only a fast "met" the drained read denies would.
+        if (!met && acquire.Matches(exact)) {
+            ++met_later;
+        } else if (met && !acquire.Matches(exact) && differences++ < 16) {
+            LOG_WARNING(HW_GPU, "Semaphore fast check: {:#x} op {} value {:#x}: fast {:#x}, drained {:#x}",
+                        address, static_cast<u32>(op), acquire.value, word, exact);
+        }
+        if ((checks & 0xffff) == 0) {
+            LOG_INFO(HW_GPU, "Semaphore fast check: {} acquires, {} differed, {} met during the drain",
+                     checks, differences, met_later);
+        }
+        return false;
+    }
+    if (met) {
+        VideoCommon::Nx2Profile::Add(VideoCommon::Nx2Profile::Counter::AcquireChecks, 1);
+    }
+    return met;
+}
