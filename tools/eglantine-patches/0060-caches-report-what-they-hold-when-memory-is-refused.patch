 }
 
+template <class P>
+void TextureCache<P>::ReportMemory() {
+    // As the collector counts them: a scaled image holds its original too, an unbacked one only
+    // what is bound to it.
+    const auto held = [this](const Image& image) {
+        return ImageMemoryBytes(image) + (image.HasScaled() ? GetScaledImageSizeBytes(image) : 0);
+    };
+    struct Entry {
+        u64 bytes;
+        const Image* image;
+    };
+    std::array<Entry, 10> largest{};
+    size_t images{}, unbacked{}, idle_images{};
+    u64 total{}, modified{}, idle{};
+    for (const auto [image_id, image] : slot_images) {
+        const u64 bytes = held(*image);
+        ++images;
+        total += bytes;
+        unbacked += True(image->flags & ImageFlagBits::Unbacked) ? 1 : 0;
+        modified += True(image->flags & ImageFlagBits::GpuModified) ? bytes : 0;
+        Entry entry{bytes, image};
+        for (Entry& place : largest) {
+            if (entry.bytes > place.bytes) {
+                std::swap(entry, place);
+            }
+        }
+    }
+    // What the collector could take at its most aggressive (ticks_to_destroy in its hardest mode).
+    constexpr u64 IdleFrames = 10;
+    if (frame_tick > IdleFrames) {
+        lru_cache.ForEachItemBelow(frame_tick - IdleFrames, [&](ImageId image_id) {
+            ++idle_images;
+            idle += held(slot_images[image_id]);
+        });
+    }
+    std::fprintf(stderr,
+                 "EDEN_REFUSED_IMAGES %zu images hold %llu MiB, %zu of them with nothing bound; "
+                 "%llu MiB written by the GPU; %zu images, %llu MiB, unused for %llu frames; the "
+                 "collector counts %llu MiB against its marks of %llu and %llu MiB\n",
+                 images, static_cast<unsigned long long>(total >> 20), unbacked,
+                 static_cast<unsigned long long>(modified >> 20), idle_images,
+                 static_cast<unsigned long long>(idle >> 20),
+                 static_cast<unsigned long long>(IdleFrames),
+                 static_cast<unsigned long long>(total_used_memory >> 20),
+                 static_cast<unsigned long long>(expected_memory >> 20),
+                 static_cast<unsigned long long>(critical_memory >> 20));
+    for (const Entry& entry : largest) {
+        if (entry.image == nullptr) {
+            break;
+        }
+        const Image& image = *entry.image;
+        std::fprintf(stderr,
+                     "EDEN_REFUSED_IMAGE %.1f MiB %s %ux%ux%u, %d layers, %d levels, flags 0x%x, "
+                     "at 0x%llx\n",
+                     static_cast<double>(entry.bytes) / static_cast<double>(1ULL << 20),
+                     fmt::format("{}", image.info.format).c_str(), image.info.size.width,
+                     image.info.size.height, image.info.size.depth, image.info.resources.layers,
+                     image.info.resources.levels, static_cast<u32>(image.flags),
+                     static_cast<unsigned long long>(image.gpu_addr));
+    }
+}
+
 template <class P>
 void TextureCache<P>::QueueAsyncDecode(Image& image, ImageId image_id) {
     UNIMPLEMENTED_IF(False(image.flags & ImageFlagBits::Converted));
