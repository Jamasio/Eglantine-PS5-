     void InvalidateGPUCache();
+    /// Applies held-back guest CPU writes before a submitted list runs (EDEN_NX2_HELD_WRITES=1).
+    void ApplyHeldWritesBeforeList();
+    /// Whether EDEN_NX2_HELD_WRITES=1, so that the split queues nothing without it.
+    [[nodiscard]] bool HeldWritesOn() const;
     /// Signal the ending of command list.
     void OnCommandListEnd();
 
