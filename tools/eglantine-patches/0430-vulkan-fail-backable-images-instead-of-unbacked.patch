new file mode 100644
index 0000000000..aa450272f6
--- /dev/null
+++ b/src/video_core/vulkan_common/unbacked_fallback.h
@@ -0,0 +1,22 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include "common/common_types.h"
+
+namespace Vulkan {
+
+/// Images over this texel count may not be backed by a normal allocation. The byte-size probe in
+/// MemoryAllocator may still back a manageable large image, but this ceiling controls the sparse
+/// fallback when allocation cannot be satisfied.
+constexpr u64 MaxBackedImageTexels = u64{1} << 28;
+
+/// Whether an allocation failure may use an unbacked sparse image instead of returning null.
+/// A caller that can retry (the texture cache) gets null for backable images; callers that cannot
+/// fail keep the compatibility fallback. Images beyond the ceiling always remain eligible for it.
+constexpr bool UsesUnbackedFallback(u64 texels, bool may_fail) {
+    return texels > MaxBackedImageTexels || !may_fail;
+}
+
+} // namespace Vulkan
