diff --git a/src/video_core/gpu_split.h b/src/video_core/gpu_split.h
index dfe8ab2ead..11eeb7f398 100644
--- a/src/video_core/gpu_split.h
+++ b/src/video_core/gpu_split.h
@@ -72,6 +72,19 @@ public:
     [[nodiscard]] static bool OnBackThread() {
         return on_back_thread;
     }
+    /// Marks the calling thread as the GPU thread (the front, or the only one without the split).
+    static void MarkGpuThread() {
+        on_gpu_thread = true;
+    }
+    /// EDEN_NX2_SPLIT_QUIET=1: Drain() also waits for the back's idle hook, and only the scheduler's
+    /// owner may record or submit from BufferCache::WriteMemory.
+    [[nodiscard]] static bool QuietSwitch();
+    /// Whether the calling thread owns the Vulkan scheduler: the back while it runs, else the
+    /// GPU thread. Other threads (CPU cores, services) must not record or submit work. Without
+    /// EDEN_NX2_SPLIT_QUIET=1 every thread answers yes, as before.
+    [[nodiscard]] static bool OwnsScheduler() {
+        return !QuietSwitch() || (Get().BackRunning() ? on_back_thread : on_gpu_thread);
+    }
     /// Called on the back before it sleeps waiting for work (the rasterizer submits deferred work).
     void SetIdleHook(void (*hook)(void*), void* argument) {
         idle_hook = hook;
@@ -230,12 +243,21 @@ private:
     // Back side.
     Tegra::Engines::EngineInterface* back_engine{};
 
+    /// Whether the back is done with the Vulkan scheduler until it gets more work: set after its
+    /// idle hook ran, cleared before it executes entries. Always yes without EDEN_NX2_SPLIT_QUIET=1.
+    [[nodiscard]] bool BackQuiet() const {
+        return !QuietSwitch() || back_quiet.load(std::memory_order_acquire) ||
+               !back_running.load(std::memory_order_acquire);
+    }
+
     static GpuSplit instance;
     static inline thread_local bool on_back_thread{};
+    static inline thread_local bool on_gpu_thread{};
     void (*idle_hook)(void*){};
     void* idle_argument{};
     alignas(64) std::atomic<bool> hook_requested{};
     std::atomic<bool> back_running{};
+    std::atomic<bool> back_quiet{true};
 
     // 128 bytes: x86 spatial prefetchers pull 64-byte lines in pairs. back_waiting and wake are
     // always touched together by both threads, so they share a block.
