diff --git a/src/shader_recompiler/frontend/maxwell/translate/impl/hmma_native.cpp b/src/shader_recompiler/frontend/maxwell/translate/impl/hmma_native.cpp
new file mode 100644
index 0000000000..4b16734c57
--- /dev/null
+++ b/src/shader_recompiler/frontend/maxwell/translate/impl/hmma_native.cpp
@@ -0,0 +1,124 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "common/bit_field.h"
+#include "common/common_types.h"
+#include "shader_recompiler/exception.h"
+#include "shader_recompiler/frontend/maxwell/translate/impl/impl.h"
+
+namespace Shader::Maxwell {
+
+// HMMA.1688.F16 / HMMA.16816.F16, which frontend/ampere/lower_to_maxwell.h (case 0x23c) lowers to
+// this pseudo-instruction unless EDEN_NX2_HMMA_NATIVE=0: D(16x8) = A(16xK) * B(Kx8) + C, K = 8 or
+// 16, f16 fragments. Lane t (group g = t/4, i = t%4): A registers hold rows g / g+8 at k 2i..2i+1
+// (a0, a1) and, for K = 16, 8+2i.. (a2, a3); B registers hold k 2i.. (b0) / 8+2i.. (b1) of column
+// g; C and D hold rows g / g+8 at columns 2i, 2i+1.
+//
+// The IR is the one the lowering's Maxwell expansion of the same instruction translates to, built
+// here directly: the same lane shuffles (SHFL.IDX, clamp 31), half extractions (F2F.F32.F16),
+// fused multiply-adds (FFMA: round to nearest, no flush) in the same order, roundings to half after
+// every eight products (F2F.F16.F32) and the final join (ISCADD by 16). Products are summed in f32.
+// Only the Maxwell temporaries, the scratch registers and the borrowed register quartet are gone.
+void TranslatorVisitor::HMMA_NATIVE(u64 insn) {
+    union {
+        u64 raw;
+        BitField<0, 8, u64> dest;
+        BitField<8, 8, u64> a;
+        BitField<20, 8, u64> b;
+        BitField<39, 8, u64> c;
+        BitField<47, 1, u64> deep;
+    } const hmma{insn};
+
+    const u32 dest = static_cast<u32>(hmma.dest.Value());
+    const u32 a = static_cast<u32>(hmma.a.Value());
+    const u32 b = static_cast<u32>(hmma.b.Value());
+    const u32 c = static_cast<u32>(hmma.c.Value());
+    const u32 depth = hmma.deep != 0 ? 16U : 8U;
+    const u32 a_count = depth / 4, b_count = depth / 8;
+    if ((dest & 1) || dest + 2 > 255 || (a & (a_count - 1)) || a + a_count > 255 ||
+        (b & (b_count - 1)) || b + b_count > 255 || (c != 255 && ((c & 1) || c + 2 > 255))) {
+        throw LogicError("Invalid HMMA_NATIVE registers {:#x}", insn);
+    }
+    const auto reg = [](u32 index) { return static_cast<IR::Reg>(index); };
+
+    // F2F.F32.F16 (the expansion's extract_half) and F2F.F16.F32 (its round_half), as
+    // floating_point_conversion_floating_point.cpp translates them: round to nearest, no flush;
+    // the half result is packed with a zero high half.
+    const IR::FpControl convert_control{
+        .no_contraction = false,
+        .rounding = IR::FpRounding::RN,
+        .fmz_mode = IR::FmzMode::None,
+    };
+    // FFMA with no modifiers, as floating_point_fused_multiply_add.cpp translates it.
+    const IR::FpControl fma_control{
+        .no_contraction = true,
+        .rounding = IR::FpRounding::RN,
+        .fmz_mode = IR::FmzMode::None,
+    };
+    const auto to_f32 = [&](const IR::Value& unpacked, u32 half) {
+        const IR::F16 value{ir.CompositeExtract(unpacked, half)};
+        return IR::F32{ir.FPConvert(32, value, convert_control)};
+    };
+    const auto to_half_bits = [&](const IR::F32& value) {
+        const IR::F16 rounded{ir.FPConvert(16, value, convert_control)};
+        const IR::F16 zero{ir.FPConvert(16, ir.Imm32(0.0f))};
+        return ir.PackFloat2x16(ir.CompositeConstruct(rounded, zero));
+    };
+    // SHFL.IDX with the immediate mask 0x1f: clamp 31, no segmentation.
+    const auto shuffle = [&](u32 source, const IR::U32& lane) {
+        return ir.ShuffleIndex(X(reg(source)), lane, ir.Imm32(31), ir.Imm32(0));
+    };
+
+    // acc[row][col]: D[g (+8)][2i (+1)], starting from C (RZ reads zero).
+    IR::F32 acc[2][2];
+    for (u32 row = 0; row < 2; ++row) {
+        const IR::Value unpacked{ir.UnpackFloat2x16(X(c == 255 ? IR::Reg::RZ : reg(c + row)))};
+        for (u32 col = 0; col < 2; ++col) {
+            acc[row][col] = to_f32(unpacked, col);
+        }
+    }
+    IR::U32 bits[2][2];
+    const IR::U32 lane{ir.LaneId()};
+    const IR::U32 row_lanes{ir.BitwiseAnd(lane, ir.Imm32(0x1c))};                         // 4g
+    const IR::U32 column_lanes{ir.ShiftLeftLogical(ir.BitwiseAnd(lane, ir.Imm32(3)), ir.Imm32(3))}; // 8i
+    for (u32 pair = 0; pair < depth / 2; ++pair) {
+        // k = 2 pair, 2 pair + 1: A rows from lane 4g + pair % 4, B columns 2i and 2i + 1 from
+        // lanes 8i + pair % 4 and 8i + 4 + pair % 4.
+        const u32 chunk = pair / 4, step = pair % 4;
+        const IR::U32 a_lane{ir.IAdd(row_lanes, ir.Imm32(step))};
+        const IR::U32 b_lane{ir.IAdd(column_lanes, ir.Imm32(step))};
+        const IR::Value a_rows[2]{
+            ir.UnpackFloat2x16(shuffle(a + chunk * 2, a_lane)),
+            ir.UnpackFloat2x16(shuffle(a + chunk * 2 + 1, a_lane)),
+        };
+        const IR::Value b_columns[2]{
+            ir.UnpackFloat2x16(shuffle(b + chunk, b_lane)),
+            ir.UnpackFloat2x16(shuffle(b + chunk, ir.IAdd(b_lane, ir.Imm32(4)))),
+        };
+        for (u32 half = 0; half < 2; ++half) {
+            const IR::F32 b_values[2]{to_f32(b_columns[0], half), to_f32(b_columns[1], half)};
+            for (u32 row = 0; row < 2; ++row) {
+                const IR::F32 a_value{to_f32(a_rows[row], half)};
+                for (u32 col = 0; col < 2; ++col) {
+                    acc[row][col] = IR::F32{ir.FPFma(a_value, b_values[col], acc[row][col], fma_control)};
+                }
+            }
+        }
+        if (step == 3) {
+            for (u32 row = 0; row < 2; ++row) {
+                for (u32 col = 0; col < 2; ++col) {
+                    bits[row][col] = to_half_bits(acc[row][col]);
+                    if (pair + 1 < depth / 2) {
+                        acc[row][col] = to_f32(ir.UnpackFloat2x16(bits[row][col]), 0);
+                    }
+                }
+            }
+        }
+    }
+    // D = (column 2i+1 << 16) + column 2i, written after every source has been read.
+    for (u32 row = 0; row < 2; ++row) {
+        X(reg(dest + row), ir.IAdd(ir.ShiftLeftLogical(bits[row][1], ir.Imm32(16)), bits[row][0]));
+    }
+}
+
+} // namespace Shader::Maxwell
