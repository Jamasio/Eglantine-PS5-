+// Reads a semaphore word, flushing a GPU-written copy out of the buffer cache first. The flush
+// reaches the scheduler (buffer cache downloads), which belongs to the back thread even once it
+// has drained: run it there, after everything sent so far, and wait for it. The wait is the drain
+// the callers needed anyway, so this adds no round trip.
+u32 ReadSemaphoreWord(DmaPusher& dma_pusher, GPUVAddr address) {
+    if (const auto device = dma_pusher.memory_manager.GpuToCpuAddress(address)) {
+        OnBack([rasterizer = dma_pusher.rasterizer, device = *device] {
+            if (rasterizer->MustFlushRegion(device, sizeof(u32), VideoCommon::CacheType::BufferCache)) {
+                rasterizer->FlushRegion(device, sizeof(u32), VideoCommon::CacheType::BufferCache);
+            }
+        });
+    }
+    DrainBack();
+    return dma_pusher.memory_manager.Read<u32>(address);
+}
+
