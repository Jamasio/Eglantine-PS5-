diff --git a/src/video_core/renderer_vulkan/vk_rasterizer.cpp b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
index 2e1887ea5a..d14a7268ff 100644
--- a/src/video_core/renderer_vulkan/vk_rasterizer.cpp
+++ b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
@@ -1108,6 +1108,10 @@ void RasterizerVulkan::DrawTexture() {
     std::scoped_lock l{texture_cache.mutex};
     texture_cache.SynchronizeDescriptors(false);
     texture_cache.UpdateRenderTargets(false);
+    // A deferred fragment barrier: this draw does not pass through GraphicsPipeline::ConfigureImpl.
+    if (scheduler.HasFragmentBarrier()) {
+        scheduler.RequestOutsideRenderPassOperationContext();
+    }
 
     UpdateDynamicStates();
 
@@ -1719,6 +1723,19 @@ void RasterizerVulkan::WaitForIdle() {
 }
 
 void RasterizerVulkan::FragmentBarrier() {
+    // EDEN_NX2_DEFER_FRAGMENT_BARRIER=1: the next draw ends the render pass only if it samples a
+    // render target of the pass, or the pass wrote storage (GraphicsPipeline::ConfigureImpl).
+    // Ocarina of Time asks for ~100 of these a frame and nearly all follow unrelated draws. Lichii
+    // PR 161 (commit 3985ac21c6) and PR 184 (commit 60e565c440, a pending barrier survives
+    // unrelated draws).
+    static const bool defer = [] {
+        const char* value = std::getenv("EDEN_NX2_DEFER_FRAGMENT_BARRIER");
+        return value != nullptr && value[0] == '1';
+    }();
+    if (defer && scheduler.IsRenderPassActive()) {
+        scheduler.DeferFragmentBarrier();
+        return;
+    }
     // We already put barriers when a render pass finishes
     scheduler.RequestOutsideRenderPassOperationContext();
 }
