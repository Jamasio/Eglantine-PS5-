diff --git a/src/video_core/renderer_vulkan/vk_scheduler.h b/src/video_core/renderer_vulkan/vk_scheduler.h
index e102c82260..bec1f26a70 100644
--- a/src/video_core/renderer_vulkan/vk_scheduler.h
+++ b/src/video_core/renderer_vulkan/vk_scheduler.h
@@ -106,6 +106,25 @@ public:
         return state.renderpass != VK_NULL_HANDLE;
     }
 
+    /// EDEN_NX2_DEFER_FRAGMENT_BARRIER=1: the fragment barrier of an active render pass waits for
+    /// a draw that needs it (GraphicsPipeline::ConfigureImpl). Ending the pass clears it.
+    void DeferFragmentBarrier() {
+        fragment_barrier_pending = true;
+    }
+
+    bool HasFragmentBarrier() const {
+        return fragment_barrier_pending;
+    }
+
+    /// A draw of the active render pass writes storage: a later barrier must end the pass.
+    void NoteRenderPassStores() {
+        render_pass_has_stores = true;
+    }
+
+    bool RenderPassHasStores() const {
+        return render_pass_has_stores;
+    }
+
     /// Update the pipeline to the current execution context.
     bool UpdateGraphicsPipeline(GraphicsPipeline* pipeline);
 
@@ -358,6 +377,8 @@ private:
     const Device& device;
     StateTracker& state_tracker;
 
+    bool fragment_barrier_pending{};
+    bool render_pass_has_stores{};
     std::unique_ptr<MasterSemaphore> master_semaphore;
     std::unique_ptr<CommandPool> command_pool;
 
