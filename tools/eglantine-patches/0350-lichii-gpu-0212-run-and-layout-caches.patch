 size_t MemoryManager::GetMemoryLayoutSize(GPUVAddr gpu_addr, size_t max_size) const {
+    // The layout part of Lichii PR 175 (zortos293/Lichii, 2aea767bb3): every draw rebinds each
+    // storage buffer through this lookup and its mutex. EDEN_NX2_BIND_CACHE=1 keeps the answers
+    // per thread, across page table changes elsewhere (as the run cache of PR 179 does); =2 also
+    // looks each one up, logs differences and uses that. The PR caches the whole binding; that
+    // code is what fog-03 changes, and what is left of it is the two table reads of
+    // GpuToCpuAddress. 40 KiB per thread that gets here, allocated at its first call.
+    static const int mode = [] {
+        const char* value = std::getenv("EDEN_NX2_BIND_CACHE");
+        return value == nullptr ? 0 : value[0] - '0';
+    }();
+    if (mode > 0) {
+        struct Entry {
+            size_t owner;
+            GPUVAddr gpu_addr;
+            u64 serial;
+            size_t result;
+        };
+        thread_local std::array<Entry, 1024> layouts{};
+        const u64 serial = map_serial.load(std::memory_order_acquire);
+        Entry& entry = layouts[(gpu_addr * 0x9E3779B97F4A7C15ULL) >> 54];
+        if (entry.owner == unique_identifier + 1 && entry.gpu_addr == gpu_addr &&
+            (entry.serial == serial ||
+             UnchangedSince(entry.serial, serial, gpu_addr & ~big_page_mask,
+                            gpu_addr + entry.result + big_page_size))) {
+            entry.serial = serial;
+            if (mode >= 2) [[unlikely]] {
+                std::unique_lock<std::mutex> lock(guard);
+                const size_t expected = kind_map.GetContinuousSizeFrom(gpu_addr);
+                static std::atomic<u32> logged{};
+                if (expected != entry.result &&
+                    logged.fetch_add(1, std::memory_order_relaxed) < 64) {
+                    LOG_ERROR(HW_GPU, "GetMemoryLayoutSize({:#x}): cached {:#x}, looked up {:#x}",
+                              gpu_addr, entry.result, expected);
+                }
+                return expected;
+            }
+            return entry.result;
+        }
+        std::unique_lock<std::mutex> lock(guard);
+        const size_t result = kind_map.GetContinuousSizeFrom(gpu_addr);
+        entry = {unique_identifier + 1, gpu_addr, serial, result};
+        return result;
+    }
     std::unique_lock<std::mutex> lock(guard);
     return kind_map.GetContinuousSizeFrom(gpu_addr);
 }
